#!/usr/bin/env sh

# Проверяем, есть ли среди пушаемых коммитов изменения frontend
PUSH_TOUCHES_FRONTEND=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" | grep -q "^frontend/"; then
    PUSH_TOUCHES_FRONTEND=1
    break
  fi
done

if [ "$PUSH_TOUCHES_FRONTEND" -eq 0 ]; then
  echo " [Husky] Пуш не затрагивает frontend. Пропускаем тесты."
  exit 0
fi

FRONTEND_DIR="$(git rev-parse --show-toplevel)/frontend"
cd "$FRONTEND_DIR" || exit 1

echo " [Husky] Пуш затрагивает frontend — запускаю полный набор тестов..."
npm test || npm.cmd test || exit 1
